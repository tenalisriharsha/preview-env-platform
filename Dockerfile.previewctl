# Image for the in-cluster cleanup CronJob (k8s/cleanup/): previewctl plus
# the kubectl binary it shells out to. Build from the repository root:
#
#   docker build -f Dockerfile.previewctl -t previewctl:0.1.0 .
#
# kubectl is downloaded from dl.k8s.io and checked against the pinned
# SHA-256 for the target architecture (amd64 or arm64). PYTHON_IMAGE lets
# you swap the base, e.g. for a digest-pinned or mirrored python:3.12-slim.

ARG PYTHON_IMAGE=python:3.12-slim

FROM ${PYTHON_IMAGE} AS build
WORKDIR /src
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --root-user-action=ignore --prefix=/install .

FROM ${PYTHON_IMAGE}
ARG TARGETARCH
ARG KUBECTL_VERSION=v1.34.1
ARG KUBECTL_SHA256_amd64=7721f265e18709862655affba5343e85e1980639395d5754473dafaadcaa69e3
ARG KUBECTL_SHA256_arm64=420e6110e3ba7ee5a3927b5af868d18df17aae36b720529ffa4e9e945aa95450

ADD --chmod=755 https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl /usr/local/bin/kubectl
RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) sum="$KUBECTL_SHA256_amd64" ;; \
      arm64) sum="$KUBECTL_SHA256_arm64" ;; \
      *) echo "unsupported TARGETARCH $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    echo "$sum  /usr/local/bin/kubectl" | sha256sum -c -

COPY --from=build /install /usr/local

# kubectl writes its discovery cache under $HOME; the CronJob mounts a
# writable emptyDir at /tmp and keeps the root filesystem read-only.
ENV HOME=/tmp
USER 65532:65532
ENTRYPOINT ["previewctl"]
CMD ["--help"]
